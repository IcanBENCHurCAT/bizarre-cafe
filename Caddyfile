{
    # Global options block
    admin off
}

{$DOMAIN:{$DUCKDNS_SUBDOMAIN:bizarre-cafe}.duckdns.org} {
    encode gzip zstd

    # Strict Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Reverse proxy to Bizarre Cafe application container
    # flush_interval -1 disables buffering for real-time SSE streaming (/sse)
    reverse_proxy app:8080 {
        flush_interval -1
    }
}

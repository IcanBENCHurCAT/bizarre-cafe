# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bizarre_cafe
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI/LLM
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=http://localhost:8080/v1
AI_MODEL=qwen3.6-35b-a3b-nvfp4

# Algorand / x402
ALGORAND_NETWORK=testnet
ALGORAND_RPC_URL=https://testnet-api.algonode.cloud
X402_CONFIG={"provider":"algorand","network":"testnet","contracts":{}}

# Server
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*

# JWT / Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSE
SSE_TIMEOUT_MS=300000
SSE_HEARTBEAT_MS=30000

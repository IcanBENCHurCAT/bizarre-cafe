# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bizarre_cafe
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI/LLM
# Single endpoint configuration (legacy / fallback)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=http://localhost:8080/v1
AI_MODEL=qwen3.6-35b-a3b-nvfp4

# Provider Cascade Configuration (optional)
# Comma-separated list of providers to use for failover. Unconfigured providers are skipped.
BIZARRE_CAFE_PROVIDER_CASCADE=gemini,groq,openrouter

# Gemini configuration
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq configuration
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter configuration
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Algorand / x402
ALGORAND_NETWORK=testnet
ALGORAND_RPC_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=http://localhost:8980
ALGORAND_RECEIVER_WALLET=ALGO_BIZARRE_CAFE_WALLET_ADDRESS
ALGORAND_MOCK_VERIFICATION=true
X402_CONFIG={"provider":"algorand","network":"testnet","contracts":{}}

# Server
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=*

# JWT / Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSE
SSE_TIMEOUT_MS=300000
SSE_HEARTBEAT_MS=15000

{
  "name": "bizarre-cafe",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "A2A conversational cafe platform with x402 payments",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "deploy:gcp": "bash scripts/deploy-gcp.sh",
    "deploy:gcp-setup": "bash scripts/deploy-gcp-setup.sh",
    "deploy:oci": "bash scripts/deploy-oci.sh",
    "deploy:oci-check": "bash scripts/check-deployment.sh",
    "setup:supabase": "bash scripts/setup-supabase.sh",
    "test:local": "bash scripts/test-local.sh",
    "seed:data": "bash scripts/seed-data.sh",
    "simulate": "tsx scripts/simulate-agents.ts",
    "dev:all": "bash scripts/start-local.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@langchain/core": "^1.3.2",
    "@langchain/openai": "^1.8.0",
    "@noble/ed25519": "^3.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-core": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "algosdk": "^3.9.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "js-tokens": "^10.0.0",
    "key-did-provider-ed25519": "^4.0.2",
    "key-did-resolver": "^4.0.0",
    "langchain": "^1.6.0",
    "loose-envify": "^1.4.0",
    "react": "^19.3.1",
    "readable-stream": "^4.8.0",
    "supabase": "^2.122.0",
    "typescript-eslint": "^8.72.1",
    "ws": "^8.21.1",
    "x402": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "a2a",
    "x402",
    "conversational",
    "cafe",
    "payments",
    "algorand"
  ],
  "author": "IcanBENCHurCAT",
  "license": "MIT",
  "overrides": {
    "ws": "^8.21.1",
    "viem": {
      "ws": "^8.21.1"
    },
    "@walletconnect/utils": {
      "ws": "^8.21.1"
    },
    "decode-uri-component": "^0.5.1",
    "uuid": "^11.1.1",
    "@vitest/mocker": "^4.1.12",
    "@stablelib/ed25519": "^2.1.0",
    "follow-redirects": "^1.16.2",
    "abitype": "^1.3.0",
    "@coinbase/cdp-sdk": {
      "zod": "^4.6.7"
    },
    "@reown/appkit-wallet": {
      "zod": "^4.6.7"
    },
    "x402": {
      "zod": "^4.6.7"
    }
  }
}
